{
  "disable_ai": true,

 "vim_mode": false,
  "inline_code_actions": true,
  "base_keymap": "VSCode",
  "always_treat_brackets_as_autoclosed": true,
  "use_system_path_prompts": false,
  "cli_default_open_behavior": "new_window",
  "git": {
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "show_commit_summary": false,
    },
    "enable_diff": true,
    "enable_status": true,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "extend_comment_on_newline": false,
  "max_tabs": 1,
  "tab_bar": {
    "show": false,
  },
  "status_bar": {
    "experimental.show": false,
    "cursor_position_button": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_sign_in": false,
    "show_user_menu": false,
  },
  "show_wrap_guides": true,
  "rounded_selection": true,
  "current_line_highlight": "all",
  "ui_font_family": ".ZedSans",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "buffer_line_height": "standard",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_features": {
    "calt": true, // Ligatures: != => -> <= |>
    "zero": true, // Slashed zero: 0
    "cv06": true, // Shorten letter: m
    "cv07": true, // Shorten letters: w, W
    "cv14": true, // Broken line in : $
  },
  "terminal": {
    "default_height": 361,
    "scrollbar": {
      "show": "never",
    },
    "font_features": {
      "calt": false,
      "zero": true,
      "cv06": true,
      "cv07": true,
      "cv14": true,
    },
  },
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard",
    "default_width": 350,
  },
  "outline_panel": {
    "dock": "right",
    "default_width": 300,
  },
  "file_scan_exclusions": [
    // Python
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.import_linter_cache",
    // Defaults
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "wrap_guides": [80],
      "language_servers": [
        "ty",
        "ruff",
        "cspell",
        "!basedpyright",
        "!pyright",
        "!pylsp",
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
    },
    "Rust": {
      "tab_size": 4,
      "wrap_guides": [100],
    },
    "JavaScript": {
      "formatter": ["prettier"],
    },
    "TypeScript": {
      "formatter": ["prettier"],
    },
    "Vue.js": {
      "formatter": ["prettier"],
    },
  },

  "debugger": {
    "stepping_granularity": "statement",
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme_overrides": {
    "Ayu Dark": {
      "syntax": {
        "keyword": {
          "color": "#FF823F",
        },
        "operator": {
          "color": "#FF823F",
        },
        "function": {
          "color": "#FABA53",
        },
        "string": {
          "color": "#32AA32",
        },
        "number": {
          "color": "#6391fd",
        },
        "property": {
          "color": "#bfbdb6ff",
        },
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "normal",
        },
      },
    },
  },
  "semantic_tokens": "combined",
  "lsp": {
    "ty": {
      "binary": {
        "path": "C:\\Users\\goncharukak\\.local\\bin\\ty.exe",
        "arguments": ["server"],
      },
    },
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "token_type": "clsParameter",
        "foreground_color": "#bb8aff",
      },
      {
        "token_type": "selfParameter",
        "foreground_color": "#bb8aff",
      },
      {
        "token_type": "selfKeyword",
        "foreground_color": "#bb8aff",
      },
      {
        "token_type": "enum",
        "style": ["type"],
      },
      {
        "token_type": "parameter",
        "token_modifiers": ["declaration"],
        "foreground_color": "#bfbdb6ff",
      },
      {
        "token_type": "parameter",
        "token_modifiers": ["callable"],
        "style": ["function"],
      },
      {
        "token_type": "parameter",
        "foreground_color": "#5ac1fe88",
      },
      {
        "token_type": "variable",
        "token_modifiers": ["declaration"],
        "foreground_color": "#bfbdb6ff",
      },
      {
        "token_type": "typeParameter",
        "foreground_color": "#ff80ce",
      },
      {
        "token_type": "variable",
        "foreground_color": "#5ac1fe",
      },
      {
        "token_type": "property",
        "token_modifiers": ["declaration"],
        "foreground_color": "#bfbdb6ff",
      },
      {
        "token_type": "property",
        "foreground_color": "#5ac1fe88",
      },
      {
        "token_type": "decorator",
        "style": ["function"],
      },
    ],
  },
}
